{
  "arch": {
    "build": "native",
    "package": "arch",
    "target": "target",
    "archive": "warp-terminal-oss-*.pkg.tar.zst",
    "suffix": ".pkg.tar.zst",
    "packaging_image": "archlinux:base-devel"
  },
  "ubuntu": {
    "build": "container",
    "package": "deb",
    "target": "target/ubuntu-24.04",
    "archive": "warp-terminal-oss_*_amd64.deb",
    "suffix": "_amd64.deb",
    "image": "ubuntu:24.04",
    "dependencies": [
      "ca-certificates", "curl", "git", "build-essential", "cmake", "pkg-config",
      "python-is-python3", "libssl-dev", "libfreetype-dev", "libexpat1-dev",
      "libgit2-dev", "libfontconfig1-dev", "jq", "brotli", "libasound2-dev",
      "libclang-dev", "clang", "lld", "protobuf-compiler", "libprotobuf-dev", "unzip", "fakeroot",
      "libegl1", "libwayland-client0", "libwayland-egl1", "libx11-6", "libxcb1",
      "libxcursor1", "libxi6", "libxkbcommon-x11-0", "zlib1g"
    ]
  }
}
